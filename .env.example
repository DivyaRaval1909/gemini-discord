# ===================================================
# DISCORD BOT CREDENTIALS
# ===================================================
# Get these from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_client_id_here

# (Optional) Provide your Discord server ID for INSTANT slash command updates during dev.
# If omitted, commands are registered globally (can take up to 1 hour to propagate).
GUILD_ID=

# Set to "true" if you want the bot to automatically register slash commands on every startup
AUTO_DEPLOY_COMMANDS=true

# ===================================================
# GOOGLE GEMINI AI CONFIGURATION
# ===================================================
# Get your free Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=your_google_gemini_api_key_here

# Recommended model: gemini-2.5-flash (fast, smart, cost-efficient) or gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash
